# Copy to .env and fill in. Real environment variables take precedence over this file.
ANTHROPIC_API_KEY=sk-ant-...

# RECEIPT_EXTRACTOR=anthropic        # or: ollama
# RECEIPT_ANTHROPIC_MODEL=claude-opus-5-5
# RECEIPT_ANTHROPIC_TIMEOUT=90           # seconds per attempt (1 retry)
